ENVIRONMENT=production
SECRET_KEY=replace_with_a_random_secret_at_least_32_bytes
ACCESS_TOKEN_EXPIRE_MINUTES=480
# 10 is suitable for a small CPU-constrained server; accepted range is 10-14.
BCRYPT_ROUNDS=10
# Allows the existing EXE to create an employee from Windows hostname/user/SID
# on first launch. Set false if every device must be manually pre-approved.
ALLOW_DEVICE_AUTO_ENROLLMENT=true
# Use DATABASE_URL, or remove it and uncomment the individual DB_* settings.
DATABASE_URL=mssql+pyodbc://user:password@localhost/TrackerDB?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
# DB_SERVER=localhost
# DB_USER=tracker_app
# DB_PASSWORD=replace_me
# DB_NAME=TrackerDB
# DB_PORT=1433
# DB_DRIVER=ODBC Driver 18 for SQL Server
# DB_ENCRYPT=true
# DB_TRUST_SERVER_CERT=false

FRONTEND_URL=https://tracker.example.com

# Shared-PC v3 Microsoft sign-in (optional; existing Windows agent stays supported).
# Generate a random enrollment key (at least 32 characters), enter once per
# Windows profile during administrator setup. Never distribute client secret.
# WORK_ENROLLMENT_KEY=
# WORK_PUBLIC_API_URL=https://tracker.greencall.online/api
# WORK_MICROSOFT_ISSUER=https://login.microsoftonline.com/YOUR_TENANT_UUID/v2.0
# WORK_MICROSOFT_CLIENT_ID=
# WORK_MICROSOFT_CLIENT_SECRET=
# Entra app: single-tenant, Web redirect URI:
# https://tracker.greencall.online/api/work/callback/microsoft
