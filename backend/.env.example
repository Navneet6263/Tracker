ENVIRONMENT=production
SECRET_KEY=replace_with_a_random_secret_at_least_32_bytes
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Allows the existing EXE to create an employee from Windows hostname/user/SID
# on first launch. Set false if every device must be manually pre-approved.
ALLOW_DEVICE_AUTO_ENROLLMENT=true
# Use DATABASE_URL, or remove it and uncomment the individual DB_* settings.
DATABASE_URL=mssql+pyodbc://user:password@localhost/TrackerDB?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
# DB_SERVER=localhost
# DB_USER=tracker_app
# DB_PASSWORD=replace_me
# DB_NAME=TrackerDB
# DB_PORT=1433
# DB_DRIVER=ODBC Driver 18 for SQL Server
# DB_ENCRYPT=true
# DB_TRUST_SERVER_CERT=false

FRONTEND_URL=https://tracker.example.com
